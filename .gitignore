.DS_Store

# Galerías de cliente: el código va en git; las fotos/hash/caché viven en el servidor
galerias/data/*
!galerias/data/.htaccess
!galerias/data/index.php

# Selección de fotos del portafolio (la escribe el panel, vive en el servidor)
fotos-config.json

# Renta de equipo: el catálogo editado, las métricas y las fotos subidas viven en el servidor
renta/data/*
!renta/data/.htaccess
!renta/data/index.php
renta/fotos/*
!renta/fotos/.htaccess
